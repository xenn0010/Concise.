# Concise SDK Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API Key (required for TALE zero-shot optimization)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration (optional - required for API endpoints)
DATABASE_URL=postgresql://user:password@localhost:5432/concise
#DATABASE_URL=sqlite:///./concise.db  # Alternative: SQLite for development

# Redis Configuration (optional - falls back to in-memory cache)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true  # Set to false in production

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
